# HubSpot integration — required for the newsletter signup, partner
# contact form, and event RSVP forms to actually deliver submissions to
# your CRM.
#
# 1. Create a free HubSpot account: https://www.hubspot.com/products/crm
# 2. Find your Portal ID (Account Settings > Account Setup > Account Defaults)
# 3. Create these forms in HubSpot (Marketing > Lead Capture > Forms):
#    - "Newsletter signup" with a single Email field
#    - "Partner inquiry" with First name, Email, Company, Message fields
#    - one per event RSVP (e.g. "Tarot Workshop RSVP") with First name, Email
#    Each form's URL contains its GUID: app.hubspot.com/forms/<PORTAL_ID>/<FORM_GUID>/edit

HUBSPOT_PORTAL_ID=
HUBSPOT_NEWSLETTER_FORM_ID=
HUBSPOT_PARTNER_FORM_ID=
HUBSPOT_TAROT_FORM_ID=
